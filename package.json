{
  "name": "yvm-yt",
  "version": "1.0.0",
  "description": "Terminal UI for downloading YouTube videos — quality picker, auto-installs dependencies, outputs MP4/MP3.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/YashasVM/yt-cmd.git"
  },
  "homepage": "https://github.com/YashasVM/yt-cmd",
  "keywords": ["youtube", "yt-dlp", "downloader", "terminal", "tui", "cli", "mp4", "mp3"],
  "bin": {
    "yvm-yt": "./dist/bin/index.js",
    "yt-cmd": "./dist/bin/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "bun run bin/index.ts",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "audit": "npm audit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "figlet": "^1.11.0",
    "ink": "^5.2.1",
    "react": "^18.3.1",
    "react-devtools-core": "^4.28.5",
    "yt-dlp-wrap": "^2.3.12"
  },
  "devDependencies": {
    "@types/figlet": "^1.7.0",
    "@types/node": "^22.15.17",
    "@types/react": "^18.3.12",
    "typescript": "^5.8.3"
  }
}
